DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distem_rwanda?schema=public"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"
SESSION_TTL_DAYS=7
# Use `lax` for a same-site frontend/API deployment. Only use `none` when the
# frontend and API are on different sites; production cookies are always Secure.
SESSION_COOKIE_SAME_SITE="lax"
# Leave empty unless a shared cookie domain is deliberately required.
SESSION_COOKIE_DOMAIN=""
EMAIL_VERIFICATION_TTL_HOURS=24
FRONTEND_URL="http://localhost:5173"
# Production email delivery: provide values from the selected email provider.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# true enables the MVP/demo verification bypass; use false in production.
MVP_OFFLINE_MODE=true
